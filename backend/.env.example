APP_NAME=AMAN
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aman
DB_USERNAME=aman
DB_PASSWORD=aman-local-only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# No actual network requests until both mode and key are explicitly configured.
CAMARA_MODE=disabled
CAMARA_BASE_URL=https://network-as-code.p-eu.apihub.nokia.io
CAMARA_HOST=network-as-code.nokia.rapidapi.com
CAMARA_API_KEY=
NOKIA_REACHABILITY_ENABLED=true
POPULATION_DENSITY_PROVIDER=disabled
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_TOKEN_URL=https://api.orange.com/openidconnect/playground/v1.0/token
ORANGE_POPULATION_DENSITY_URL=https://api.orange.com/camara/playground/api/population-density-data/v0.2/retrieve
AMAN_DEMO_ENABLED=false
FRONTEND_ORIGINS=http://localhost:3000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=500
OPENAI_TIMEOUT_SECONDS=20

# CAMARA orchestration agent (ml/agent). Set AMAN_AGENT_URL to route incident
# advice through the agent instead of the single-model advisor above. Both
# tokens are private and server-side: the first authenticates Laravel to the
# agent, the second authenticates the agent back to /api/internal/agent/camara.
AMAN_AGENT_URL=
AMAN_AGENT_SERVICE_TOKEN=
AMAN_CAMARA_GATEWAY_TOKEN=
AMAN_AGENT_TIMEOUT_SECONDS=45
AMAN_DISPATCH_ACK_TIMEOUT_SECONDS=20

# Server-side service account JSON. Keep the file outside the repository.
FIREBASE_PROJECT_ID=aman-df1f1
# Defaults to storage/app/private/firebase-service-account.json when blank.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_TIMEOUT_SECONDS=10

REVERB_APP_ID=aman-local
REVERB_APP_KEY=aman-local-public-key
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
