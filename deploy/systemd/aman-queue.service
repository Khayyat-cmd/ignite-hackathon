[Unit]
Description=AMAN queue worker
After=network.target mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/aman/backend
ExecStart=/usr/bin/php artisan queue:work --queue=default --sleep=1 --tries=2 --timeout=60
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
