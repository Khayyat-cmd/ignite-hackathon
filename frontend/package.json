{
  "name": "aman-frontend",
  "productName": "AMAN Command Center",
  "description": "Control-room console for the AMAN crowd response prototype.",
  "author": "AMAN Hackathon Team",
  "desktopName": "AMANCommandCenter.desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host localhost --port 3000",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "build": "vite build",
    "build:desktop": "npm run build && electron-builder",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.aman.commandcenter",
    "productName": "AMAN Command Center",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "executableName": "aman-command-center",
      "syncDesktopName": true
    }
  }
}
